rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPER FUNCTIONS
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'superAdmin';
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    // USER PROFILES
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // CITY STATIC DATA (Baseline)
    match /taxi_stations/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('taxiAdmin'); }
    match /popular_destinations/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('taxiAdmin'); }
    match /terminal_routes/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'); }
    match /bus_routes/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'); }
    match /tourism_sites/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('tourismAdmin'); }
    match /tourism_places/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('tourismAdmin'); }
    match /hotels/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('hotelAdmin'); }
    match /hospitals/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('healthAdmin'); }
    match /pharmacies/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('pharmacyAdmin'); }
    match /food_vendors/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('businessAdmin'); }
    match /eco_shine_locations/{doc} { allow read: if true; allow write: if isSuperAdmin(); }
    match /announcements/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('emergencyAdmin'); }

    // DYNAMIC OPERATIONS

    // Drivers & Vehicles
    match /drivers/{driverId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == driverId;
      allow update: if isAuthenticated() && (request.auth.uid == driverId || isSuperAdmin() || hasRole('taxiAdmin'));
    }
    match /vehicles/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'); }
    match /buses/{doc} { allow read: if true; allow write: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'); }

    // Bookings, Tickets, and Orders
    match /bookings/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin');
    }
    match /tickets/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin'));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('oldTerminalAdmin') || hasRole('newTerminalAdmin');
    }
    match /hotel_bookings/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin() || hasRole('hotelAdmin'));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('hotelAdmin');
    }
    match /food_orders/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin() || hasRole('businessAdmin'));
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('businessAdmin');
    }

    // Ride Requests
    match /ride_requests/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId || isSuperAdmin() || hasRole('taxiAdmin'));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.auth.uid == resource.data.driverId || isSuperAdmin() || hasRole('taxiAdmin'));
    }

    // Emergency SOS
    match /emergency_requests/{doc} {
      allow read: if isSuperAdmin() || hasRole('emergencyAdmin');
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('emergencyAdmin');
    }
    match /emergency_alerts/{doc} {
      allow read: if isSuperAdmin() || hasRole('emergencyAdmin') || hasRole('taxiAdmin');
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || hasRole('emergencyAdmin');
    }

    // Analytics & System
    match /analytics/{doc} {
      allow read: if isSuperAdmin();
      allow write: if false; // Cloud Functions only
    }
    match /audit_logs/{doc} {
      allow read: if isSuperAdmin();
      allow create: if isAuthenticated();
    }
    match /payments/{doc} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      allow create: if isAuthenticated();
    }

    // Notifications
    match /notifications/{doc} {
      allow read: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
  }
}
